# Canonical URL of the deployed site — used for metadata, sitemap, RSS, and OG images.
# Defaults to this deployment URL in production; override for a custom domain.
NEXT_PUBLIC_SITE_URL=https://novandri-portfolio.vercel.app

# Keystatic production GitHub storage. Keep these values secret and set them in Vercel.
# KEYSTATIC_SECRET must be at least 32 characters long.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
